# Copy this file to .env and put your real key in below.
#   copy .env.example .env
# Then open .env and replace the placeholder with your real Anthropic API key.
# Get a key at https://console.anthropic.com/ (Settings -> API Keys).
# Treat this key like a password - anyone with it can spend on your account.
ANTHROPIC_API_KEY=sk-ant-...your-real-key-here...

# ── Optional settings (defaults shown; uncomment to override) ────────────────

# Which Claude model categorises transactions.
# CATEGORISE_MODEL=claude-sonnet-5

# How many hours processed workbooks, job records and uploads are kept
# before being deleted automatically.
# PLUTUS_RETENTION_HOURS=24

# Whether scanned (image-only) PDFs are read by sending the page images to
# Claude. Set to 0 to switch this off; scanned PDFs are then rejected with
# a clear message instead. See the README's Security notes before enabling.
# PLUTUS_SCAN_AI=1
